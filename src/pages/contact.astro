---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch with the team behind this game guide site.">
  <section class="section">
    <div class="container prose">
      <h1>Contact</h1>
      <p>
        Found a typo, outdated info, or have a tip about the game? Open an issue in the
        <a href="https://github.com/samzixiao/active-matter-guide/issues" rel="noopener noreferrer">companion repository</a>
        with the page URL and the current build number.
      </p>
      <p>
        Please include a source link for factual corrections so the page can be updated without guessing.
      </p>
    </div>
  </section>
</BaseLayout>
